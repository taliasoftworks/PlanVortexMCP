# Copia esto a `.env.live` para la capa 3 (`npm run test:live`). Sin el fichero, la capa entera se
# salta y te dice qué falta: nunca falla por no tener credenciales.

# Lo normal es apuntar a tu stack local (`docker compose up` en PlanVortexServer).
PLANVORTEX_LIVE_BASE_URL=http://localhost:3000/v1.0.0

# Una app del plan Custom. En un stack local, la que crees en el panel.
PLANVORTEX_LIVE_CLIENT_ID=
PLANVORTEX_LIVE_CLIENT_SECRET=

# La organización contra la que se leen los listados.
PLANVORTEX_LIVE_ORGANIZATION_ID=

# Opcionales: si están, se prueban las herramientas que necesitan un id concreto.
PLANVORTEX_LIVE_ACCOUNT_ID=
PLANVORTEX_LIVE_PUBLICATION_ID=

# Las escrituras están APAGADAS por defecto. Con esto en 1 se crea un borrador y se edita; nada
# sale a una red social, porque el borrador nunca se pone en `ready`.
LIVE_ALLOW_WRITE=0
